# Copy this file to backend/.env and fill in the two secrets.
# Every other value shown is the default.

# Postgres from docker compose (service "db")
DATABASE_URL=postgresql+asyncpg://meetings:meetings@localhost:5432/meetings
# Folder for uploads and processing files
STORAGE_DIR=data
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Speech-to-text and speaker detection: "local" runs on this machine, "fake" returns canned results
ASR_PROVIDER=local
DIARIZATION_PROVIDER=local
# Summaries and action items: "claude" calls the Claude API, "fake" returns a canned summary
LLM_PROVIDER=claude
# "cuda" uses the NVIDIA GPU; "cpu" is slower but works anywhere
ML_DEVICE=cuda
# faster-whisper model, and how many audio chunks it processes at once (lower it if the GPU runs out of memory)
ASR_MODEL=large-v3-turbo
ASR_BATCH_SIZE=8
# Hugging Face read token (accept the terms of pyannote/speaker-diarization-community-1 first)
HF_TOKEN=
# Anthropic API key
ANTHROPIC_API_KEY=
# Claude model and effort used for summaries, action items and decisions
LLM_MODEL_EXTRACT=claude-opus-5-5
LLM_EFFORT_EXTRACT=medium
# Time zone used to turn "by Friday" into a date
TIMEZONE=Asia/Kolkata

# Upload limits
MAX_UPLOAD_MB=500
MAX_DURATION_MINUTES=180

# Job queue
JOB_MAX_ATTEMPTS=3
JOB_STALE_MINUTES=10
HEARTBEAT_SECONDS=30
WORKER_POLL_SECONDS=5
